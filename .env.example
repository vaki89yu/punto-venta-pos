# Neon, Supabase o PostgreSQL administrado. Nunca subas .env a Git.
DATABASE_URL="postgresql://usuario:contraseña@host:5432/nombre_db?sslmode=require"

# Secreto aleatorio de al menos 32 caracteres; por ejemplo: openssl rand -base64 48
SESSION_SECRET="REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_LARGO"

# Solo se usan la primera vez que se ejecuta npm run db:initialize.
# La cuenta inicial no tiene contraseña predeterminada.
INITIAL_ADMIN_EMAIL="tu-correo@negocio.com"
INITIAL_ADMIN_PASSWORD="CAMBIA_POR_UNA_CONTRASENA_UNICA_DE_14_CARACTERES_O_MAS"
INITIAL_ADMIN_NAME="Administrador"
STORE_NAME="Mi Tienda"
